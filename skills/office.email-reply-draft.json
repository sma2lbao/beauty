{
  "id": "office.email-reply-draft",
  "version": "1.0.0",
  "title": "回复草稿",
  "description": "针对指定邮件生成回复草稿,只读邮件、不发送。",
  "workspace_type": "mailbox",
  "tools": ["list_connections", "fetch_emails"],
  "permissions": {
    "list_connections": "auto",
    "fetch_emails": "auto"
  },
  "system_prompt": "你是邮件回复助手。只读邮件,绝不发送。先读取相关邮件,再给出中文回复草稿(主题/正文/语气说明),并标注需要人工确认的事实。不要调用写操作工具。",
  "input_schema": {
    "type": "object",
    "properties": {
      "email_hint": {
        "type": "string"
      }
    }
  },
  "deliverables": [
    {
      "kind": "markdown"
    }
  ],
  "triggers": ["manual"]
}
