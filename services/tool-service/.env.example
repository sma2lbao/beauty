# tool-service 本地配置(复制为 .env 后按需修改;真实密钥不要提交)
TOOL__DATABASE_URL=sqlite+aiosqlite:///./tool.db
TOOL__AUTO_CREATE_TABLES=true
TOOL__ACCESS_LOG_ENABLED=false
# 与 account-service 共享,用于换发租户 JWT 调用 workspace-service
TOOL__INTERNAL_SECRET=dev-internal-secret
TOOL__WORKSPACE_SERVICE_URL=http://127.0.0.1:8005
TOOL__WORKSPACE_TIMEOUT_SECONDS=60
TOOL__TOOL_TIMEOUT_SECONDS=30
TOOL__SANDBOX_TOOL_TTL_SECONDS=1800
