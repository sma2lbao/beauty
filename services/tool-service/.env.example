# tool-service 本地配置(复制为 .env 后按需修改;真实密钥不要提交)
# 本地默认连 compose 的 postgres:16(每服务独立库 beauty_tool);先起库:
#   docker compose -f deploy/docker-compose.yml up -d postgres
# 迁移由 npm run dev 启动前自动执行(npm run dev:migrate 可单独跑)。
TOOL__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty_tool
TOOL__AUTO_CREATE_TABLES=true

# 单库多迁移链(多个服务共用一个库)时,给每个服务指定独立版本表
# (默认 alembic_version;共享库不要留空,否则版本号互相覆盖):
# TOOL__ALEMBIC_VERSION_TABLE=alembic_version_tool
# 离线/无 Docker 时改用 SQLite(测试即此路径):
# TOOL__DATABASE_URL=sqlite+aiosqlite:///./tool.db
TOOL__ACCESS_LOG_ENABLED=false
# 与 account-service 共享,用于换发账号 JWT 调用 workspace-service
TOOL__INTERNAL_SECRET=dev-internal-secret
TOOL__WORKSPACE_SERVICE_URL=http://127.0.0.1:8005
TOOL__WORKSPACE_TIMEOUT_SECONDS=60
# P2:search_knowledge 代理到知识库(只读检索)
TOOL__KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8006
TOOL__KNOWLEDGE_TIMEOUT_SECONDS=20
TOOL__TOOL_TIMEOUT_SECONDS=30
TOOL__SANDBOX_TOOL_TTL_SECONDS=1800
# P1 受控写:写前读校验 + 单 run 配额
TOOL__READ_BEFORE_WRITE_ENABLED=true
TOOL__MAX_WRITES_PER_RUN=50
TOOL__MAX_WRITE_BYTES_PER_RUN=5242880
TOOL__MAX_TOOL_CALLS_PER_RUN=60
# P3:fetch 只读抓取公网文本(默认关;dev 打开便于联调,测试由 NETWORK_SWITCHES 钉 False)
TOOL__FETCH_ENABLED=true
# 出口收紧(可选):逗号分隔的主机允许列表,空=任意公网主机(含子域)
TOOL__FETCH_ALLOWED_HOSTS=
# P1-L:exec 沙箱内命令执行(默认关;开启后危险工具会触发所有 run 的计划确认闸)
TOOL__EXEC_ENABLED=false
# P5:run_code 沙箱内 Python 代码执行(默认关;代码经 stdin 直传 python3 -,开启后同样会触发所有 run 的计划确认闸)
TOOL__RUN_CODE_ENABLED=false
# 连接器工具:代理到 connector-service(内部端点 X-Internal-Secret)。
# 留空 = 关闭连接器工具;须与 connector-service 的 CONNECTOR__INTERNAL_SECRET 一致。
TOOL__CONNECTOR_INTERNAL_SECRET=
TOOL__CONNECTOR_BASE_URL=http://127.0.0.1:8004
TOOL__CONNECTOR_CATALOG_TTL_SECONDS=30

# ── 观测:Langfuse(docs/design/langfuse-observability.md) ──
# 建 span 并在入站注入/续传 traceparent;导出与否由下面的 LANGFUSE_ENABLED 决定。
TOOL__TRACING_ENABLED=true
# 上报范围(2026-11-11 起):只有 agent-orchestrator 与 llm-gateway 直连 Langfuse;
# 本服务只建 span、传播 traceparent(TRACING_ENABLED=true),不导出。
# 留空/ENABLED=false = 完全不上报(零网络)。用 Cloud 时:填项目密钥 + 下面的 HOST。
# 用自托管观测 profile 时 HOST=http://localhost:3001,密钥用 pk-lf-beauty/sk-lf-beauty。
TOOL__LANGFUSE_ENABLED=false
TOOL__LANGFUSE_HOST=https://cloud.langfuse.com
TOOL__LANGFUSE_PUBLIC_KEY=
TOOL__LANGFUSE_SECRET_KEY=
# 本地/演示全采;生产按抽样成本调到 0.1~0.2(指标永不采样)。
TOOL__TRACE_SAMPLE_RATIO=1.0
# trace 里是否记录工具参数原文(默认关:只记 risk/decision/耗时/路径等元数据)。
TOOL__LOG_CONTENT=false
