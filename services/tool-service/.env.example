# tool-service 本地配置(复制为 .env 后按需修改;真实密钥不要提交)
TOOL__DATABASE_URL=sqlite+aiosqlite:///./tool.db
TOOL__AUTO_CREATE_TABLES=true
TOOL__ACCESS_LOG_ENABLED=false
# 与 account-service 共享,用于换发租户 JWT 调用 workspace-service
TOOL__INTERNAL_SECRET=dev-internal-secret
TOOL__WORKSPACE_SERVICE_URL=http://127.0.0.1:8005
TOOL__WORKSPACE_TIMEOUT_SECONDS=60
# P2:search_knowledge 代理到知识库(只读检索)
TOOL__KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8006
TOOL__KNOWLEDGE_TIMEOUT_SECONDS=20
TOOL__TOOL_TIMEOUT_SECONDS=30
TOOL__SANDBOX_TOOL_TTL_SECONDS=1800
# P1 受控写:写前读校验 + 单 run 配额
TOOL__READ_BEFORE_WRITE_ENABLED=true
TOOL__MAX_WRITES_PER_RUN=50
TOOL__MAX_WRITE_BYTES_PER_RUN=5242880
TOOL__MAX_TOOL_CALLS_PER_RUN=60
# P3:fetch 只读抓取公网文本(默认关;dev 打开便于联调,测试由 NETWORK_SWITCHES 钉 False)
TOOL__FETCH_ENABLED=true
# 出口收紧(可选):逗号分隔的主机允许列表,空=任意公网主机(含子域)
TOOL__FETCH_ALLOWED_HOSTS=
# P1-L:exec 沙箱内命令执行(默认关;开启后危险工具会触发所有 run 的计划确认闸)
TOOL__EXEC_ENABLED=false
