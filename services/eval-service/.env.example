# eval-service 本地配置(复制为 .env 后按需修改;真实密钥不要提交)
# 本地默认连 compose 的 postgres:16(每服务独立库 beauty_eval);先起库:
#   docker compose -f deploy/docker-compose.yml up -d postgres
# 迁移由 npm run dev 启动前自动执行(npm run dev:migrate 可单独跑)。
EVAL__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty_eval
EVAL__AUTO_CREATE_TABLES=true
# 离线/无 Docker 时改用 SQLite:
# EVAL__DATABASE_URL=sqlite+aiosqlite:///./eval.db
EVAL__ACCESS_LOG_ENABLED=false
# CI 上报密钥(X-Internal-Secret);留空则 POST /v1/runs 直接 503。
# 与 scripts/eval/upload.mjs 的 EVAL_INTERNAL_SECRET 同值。
EVAL__INTERNAL_SECRET=dev-internal-secret
# 本地联调可关闭鉴权:关闭时只读接口匿名可用(网关仍做会话鉴权),
# 基线批准等写入口仍要求账号;生产保持 true,读取走账号 JWT。
EVAL__AUTH_ENABLED=false
# ── 观测(docs/design/langfuse-observability.md) ──
EVAL__TRACING_ENABLED=true
EVAL__LANGFUSE_ENABLED=false
EVAL__LANGFUSE_HOST=https://cloud.langfuse.com
EVAL__LANGFUSE_PUBLIC_KEY=
EVAL__LANGFUSE_SECRET_KEY=
EVAL__TRACE_SAMPLE_RATIO=1.0
EVAL__LOG_CONTENT=false
