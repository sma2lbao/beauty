# agent-orchestrator 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
AGENT_ORCHESTRATOR__ENV=dev
AGENT_ORCHESTRATOR__LOG_LEVEL=INFO

# 方式一(零依赖):sqlite + 直建表(测试即此路径)
AGENT_ORCHESTRATOR__DATABASE_URL=sqlite+aiosqlite:///./agent_orchestrator.db
AGENT_ORCHESTRATOR__AUTO_CREATE_TABLES=true

# 方式二(贴近生产,推荐):compose 起 postgres 后,先迁移再启动——
#   docker compose -f deploy/docker-compose.yml up -d postgres
#   cd services/agent-orchestrator
#   AGENT_ORCHESTRATOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty uv run alembic upgrade head
# 然后以同 URL 启动服务;图 checkpointer 自动切 langgraph-checkpoint-postgres:
# AGENT_ORCHESTRATOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty

# 模型网关(架构 §5 唯一出口):true 时 plan/execute 走 llm-gateway
# (npx nx run llm-gateway:serve,密钥由网关进程环境提供);false 用确定性桩
AGENT_ORCHESTRATOR__LLM_ENABLED=false
AGENT_ORCHESTRATOR__LLM_GATEWAY_URL=http://127.0.0.1:8003
# AGENT_ORCHESTRATOR__LLM_MODEL=deepseek/deepseek-chat  # 不填走网关默认路由

# 工具(架构 §8):true 时 execute 走 function-calling,经 connector-service 执行
# (npx nx run connector-service:serve);false 时 execute 只产出文本小结
AGENT_ORCHESTRATOR__TOOLS_ENABLED=false
AGENT_ORCHESTRATOR__CONNECTOR_SERVICE_URL=http://127.0.0.1:8004
