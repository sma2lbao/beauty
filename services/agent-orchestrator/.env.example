# agent-orchestrator 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
AGENT_ORCHESTRATOR__ENV=dev
AGENT_ORCHESTRATOR__LOG_LEVEL=INFO

# 方式一(零依赖):sqlite + 直建表(测试即此路径)
AGENT_ORCHESTRATOR__DATABASE_URL=sqlite+aiosqlite:///./agent_orchestrator.db
AGENT_ORCHESTRATOR__AUTO_CREATE_TABLES=true

# 方式二(贴近生产,推荐):compose 起 postgres 后,先迁移再启动——
#   docker compose -f deploy/docker-compose.yml up -d postgres
#   cd services/agent-orchestrator
#   AGENT_ORCHESTRATOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty uv run alembic upgrade head
# 然后以同 URL 启动服务;图 checkpointer 自动切 langgraph-checkpoint-postgres:
# AGENT_ORCHESTRATOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty

# 模型网关(架构 §5 唯一出口):true 时 plan/execute 走 llm-gateway
# (npx nx run llm-gateway:serve,密钥由网关进程环境提供);false 用确定性桩。
# 本示例默认 false(新克隆无模型密钥);配置好网关密钥后置 true 即"全能力"模式,
# 见 docs/local-dev.md §3.7
AGENT_ORCHESTRATOR__LLM_ENABLED=false
AGENT_ORCHESTRATOR__LLM_GATEWAY_URL=http://127.0.0.1:8003
# AGENT_ORCHESTRATOR__LLM_MODEL=deepseek/deepseek-chat  # 不填走网关默认路由

# 工具(架构 §8):true 时 execute 走 function-calling,调各能力提供方
# (本地文档/知识库);false 时 execute 只产出文本小结
AGENT_ORCHESTRATOR__TOOLS_ENABLED=true

# 技能提供方(§8):未开启的能力不暴露给模型(能力即权限边界);
# 本示例全部打开,本地数据目录默认放 .cache/ 下(被 .gitignore 忽略,可随意放演示文件)
# 本地文档库:list_documents / read_document(受限目录只读;目录不存在时返回空列表)
AGENT_ORCHESTRATOR__DOCUMENTS_ENABLED=true
AGENT_ORCHESTRATOR__DOCUMENTS_ROOT=./.cache/documents
AGENT_ORCHESTRATOR__DOCUMENTS_MAX_BYTES=200000
# 企业知识库(§9):search_knowledge 工具经 knowledge-service 检索
AGENT_ORCHESTRATOR__KNOWLEDGE_ENABLED=true
AGENT_ORCHESTRATOR__KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8006

# 事务性 outbox(§6.3/§8):事件与业务同事务入发件箱,后台至少一次投递
AGENT_ORCHESTRATOR__OUTBOX_ENABLED=true
AGENT_ORCHESTRATOR__OUTBOX_DISPATCH_INTERVAL_SECONDS=1.0
AGENT_ORCHESTRATOR__OUTBOX_MAX_ATTEMPTS=5
# 交付物自动入库(§8 摄取):run 交付后推进 knowledge-service
AGENT_ORCHESTRATOR__KNOWLEDGE_INGEST_ENABLED=true

# 交付物镜像到 workspace-service(§7:artifacts 归属 workspace)
AGENT_ORCHESTRATOR__WORKSPACE_ENABLED=true
AGENT_ORCHESTRATOR__WORKSPACE_SERVICE_URL=http://127.0.0.1:8005

# 沙箱(workspace-service 内部 /v1/sandboxes):P1 基础设施;stdio MCP(P2)在其上运行,
# skill 包执行(P3-C)也在其上。依赖 workspace-service(及宿主可用的 microsandbox runtime)。
AGENT_ORCHESTRATOR__SANDBOX_ENABLED=true
AGENT_ORCHESTRATOR__SANDBOX_SERVICE_URL=http://127.0.0.1:8005

# 上传技能包执行(P3-C:skill_run 工具):需 SANDBOX_ENABLED + WORKSPACE_ENABLED
# 同时为真;沙箱网络取 run 快照的 skill_network(默认 deny)。
AGENT_ORCHESTRATOR__SKILL_EXECUTION_ENABLED=true
# 沙箱镜像:默认走 OCI registry 别名;离线/受限网络可换成本地 rootfs 目录的
# 绝对路径(需含 /usr/bin/python3,见 docs/architecture-v2.md §11.1)
AGENT_ORCHESTRATOR__SKILL_PYTHON_IMAGE=python
AGENT_ORCHESTRATOR__SKILL_NODE_IMAGE=node
AGENT_ORCHESTRATOR__SKILL_SANDBOX_TTL_SECONDS=900
AGENT_ORCHESTRATOR__SKILL_EXEC_TIMEOUT_SECONDS=600
AGENT_ORCHESTRATOR__SKILL_MAX_OUTPUT_FILES=10
AGENT_ORCHESTRATOR__SKILL_MAX_OUTPUT_BYTES=100000

# 交付物存储(§7 阶段 B):database = 内容留在 DB 列(默认);
# filesystem = 内容落本地目录,DB 只留引用(object_key/size_bytes)
AGENT_ORCHESTRATOR__ARTIFACT_STORE=database
AGENT_ORCHESTRATOR__ARTIFACT_ROOT=./.artifacts

# 浏览器直连时的跨域白名单(JSON 数组);Vite dev 走代理则用不到
# AGENT_ORCHESTRATOR__CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# 鉴权(架构 §10):默认开启——须带 Authorization: Bearer <account 签发的
# access token>,租户从 token claim 取(伪造 X-Tenant-Id 无效)。自建 IdP 即
# account-service(:8001),issuer/audience 默认已对齐;换托管 IdP(Logto)时
# 改 ISSUER/JWKS;显式关闭(AUTH_ENABLED=false)走旧临时头,不推荐
AGENT_ORCHESTRATOR__AUTH_ENABLED=true
AGENT_ORCHESTRATOR__AUTH_ISSUER=http://127.0.0.1:8001
AGENT_ORCHESTRATOR__AUTH_AUDIENCE=beauty-api
# AGENT_ORCHESTRATOR__AUTH_JWKS_URL=  # 不填走 OIDC 发现文档
# AGENT_ORCHESTRATOR__AUTH_TENANT_CLAIM=tenant_id

# 服务间调用(§5):对下游(knowledge/workspace)的内部调用一律经
# account 的 POST /v1/auth/issue 换"以目标租户为 claim"的标准 token
# (TokenBroker 进程内缓存);必须与 account 的 ACCOUNT__INTERNAL_SECRET 一致,
# 留空时启用工具/知识入库/工作区镜像即在换发处报错
# AGENT_ORCHESTRATOR__INTERNAL_AUTH_SECRET=

# run 执行队列(M0-04 本地版)
AGENT_ORCHESTRATOR__JOBS_ENABLED=true
AGENT_ORCHESTRATOR__JOBS_POLL_INTERVAL_SECONDS=0.5
AGENT_ORCHESTRATOR__JOBS_LEASE_SECONDS=60
AGENT_ORCHESTRATOR__JOBS_MAX_ATTEMPTS=3

# MCP Client(M1 本地版 + P2 stdio)
AGENT_ORCHESTRATOR__MCP_ENABLED=true
AGENT_ORCHESTRATOR__MCP_SECRET=dev-mcp-secret-change-me
# stdio MCP:命令在沙箱内拉起,需同时开启 SANDBOX_ENABLED。
# P2 出网为 public(允许 npx/uvx 安装);P4 再切 allowlist。
AGENT_ORCHESTRATOR__MCP_STDIO_ENABLED=true
AGENT_ORCHESTRATOR__MCP_STDIO_NETWORK=public
AGENT_ORCHESTRATOR__MCP_STDIO_SANDBOX_TTL_SECONDS=1800
# 镜像口径同 SKILL_*_IMAGE:默认 OCI 别名,离线时可填本地 rootfs 绝对路径
AGENT_ORCHESTRATOR__MCP_STDIO_PYTHON_IMAGE=python
AGENT_ORCHESTRATOR__MCP_STDIO_NODE_IMAGE=node

# 公开 MCP Server(M3 本地版):API Key 鉴权
AGENT_ORCHESTRATOR__MCP_SERVER_ENABLED=true
AGENT_ORCHESTRATOR__ACCOUNT_SERVICE_URL=http://127.0.0.1:8001
# 与 account-service 的 ACCOUNT__INTERNAL_SECRET 一致
AGENT_ORCHESTRATOR__INTERNAL_AUTH_SECRET=dev-internal-secret

# OAuth 2.1 受保护资源元数据
AGENT_ORCHESTRATOR__MCP_RESOURCE_URL=http://127.0.0.1:8002/mcp

# MCP 浏览器 OAuth 授权:http MCP 回 401 时,前端点「去授权」拿一次性链接;
# 授权服务器回调 BFF 同源地址(BFF 用内部凭证转给 orchestrator 兑换 token)。
# 前提:目标 server 公布 RFC 9728 资源元数据,授权服务器公布 RFC 8414/OIDC 元数据,
# 且支持 dynamic client registration(RFC 7591)或已预注册该 redirect_uri。
AGENT_ORCHESTRATOR__MCP_OAUTH_ENABLED=true
AGENT_ORCHESTRATOR__MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8007/api/mcp/oauth/callback
# 留空回退 MCP_SECRET;state 有效期(秒)与发现/换 token 的超时(秒)
# AGENT_ORCHESTRATOR__MCP_OAUTH_STATE_SECRET=
AGENT_ORCHESTRATOR__MCP_OAUTH_STATE_TTL_SECONDS=600
AGENT_ORCHESTRATOR__MCP_OAUTH_TIMEOUT_SECONDS=10
AGENT_ORCHESTRATOR__MCP_OAUTH_CLIENT_NAME=beauty-moon agent

# 编码 agent 本地文件工具(为空 = 关闭;只允许列出的目录)。
# 相对路径按服务进程 cwd 解析(nx serve 的 cwd 是服务目录),../.. 即仓库根;
# 也可写绝对路径。读取时会跳过 .git/.env/node_modules 等(见 agent_orchestrator/services/code_tools.py)。
AGENT_ORCHESTRATOR__CODE_WORKSPACE_ROOTS='["../.."]'
