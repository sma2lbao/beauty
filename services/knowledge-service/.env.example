# knowledge-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
KNOWLEDGE__ENV=dev
KNOWLEDGE__LOG_LEVEL=INFO

# ── 可观测(日志/指标/追踪/错误聚合,规范见 docs/observability.md)──────────────
# 访问日志:每请求一行 http_request 带 request_id/trace_id/route/status/duration_ms;
# 探针(/healthz、/readyz)降到 debug,慢请求另打一行 http_request_slow
KNOWLEDGE__ACCESS_LOG_ENABLED=true
KNOWLEDGE__SLOW_REQUEST_MS=1500
# 强制 JSON 日志(dev 默认人读彩色;staging/prod 固定 JSON)
# KNOWLEDGE__LOG_JSON=true
# Prometheus 指标端点 GET /internal/metrics(不经 API 网关);配了令牌则抓取必须带
# X-Metrics-Token 或 Authorization: Bearer
KNOWLEDGE__METRICS_ENABLED=true
# KNOWLEDGE__METRICS_TOKEN=
# Sentry 错误聚合:DSN 留空即完全不初始化(内网形态零副作用);业务 4xx 不入 Sentry
# KNOWLEDGE__SENTRY_DSN=
# KNOWLEDGE__SENTRY_RELEASE=
KNOWLEDGE__SENTRY_TRACES_SAMPLE_RATE=0
# OTel 追踪:OTLP_ENDPOINT 留空则零出口(span 只用于日志 trace_id 串联,不发网络);
# 填完整 …/v1/traces 地址才按 OTLP/HTTP 导出;采样由入口决定、下游跟随
# KNOWLEDGE__OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# KNOWLEDGE__OTLP_HEADERS={"x-honeycomb-team":"…"}
KNOWLEDGE__TRACING_ENABLED=true
KNOWLEDGE__TRACE_SAMPLE_RATIO=0.1

# 本地默认连 compose 的 postgres:16(每服务独立库 beauty_knowledge);先起库:
#   docker compose -f deploy/docker-compose.yml up -d postgres
# 迁移由 npm run dev 启动前自动执行(npm run dev:migrate 可单独跑)。
KNOWLEDGE__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty_knowledge
KNOWLEDGE__AUTO_CREATE_TABLES=true

# 单库多迁移链(多个服务共用一个库)时,给每个服务指定独立版本表
# (默认 alembic_version;共享库不要留空,否则版本号互相覆盖):
# KNOWLEDGE__ALEMBIC_VERSION_TABLE=alembic_version_knowledge
# 离线/无 Docker 时改用 SQLite(测试即此路径):
# KNOWLEDGE__DATABASE_URL=sqlite+aiosqlite:///./knowledge.db

# 嵌入提供方(架构 §5 唯一出口):
#   local   = 无依赖确定性词法近似向量(dev/测试;可跑通全链路,但不是语义嵌入)
#   gateway = 经 llm-gateway /v1/embeddings(生产;模型密钥由网关进程提供)
# 分块本身是本服务的纯函数(chunk_text),换嵌入模型不动分块。
KNOWLEDGE__EMBEDDING_PROVIDER=local
KNOWLEDGE__EMBEDDING_MODEL=bge-m3
KNOWLEDGE__LLM_GATEWAY_URL=http://127.0.0.1:8003
# 百炼(Model Studio)示例:模型串带 provider 前缀,dimensions 走默认 1024 维,
# 与 document_chunks.embedding 的 vector(1024) 一致(v1/v2 是 1536 维,别用)。
# 网关会按 10 行/批自动切分,本服务仍一次提交全部块。
#   KNOWLEDGE__EMBEDDING_PROVIDER=gateway
#   KNOWLEDGE__EMBEDDING_MODEL=dashscope/text-embedding-v4
# 配套改 llm-gateway: LLM_GATEWAY__EMBEDDING_API_KEY=<百炼 API Key>,
#   LLM_GATEWAY__EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   (业务空间域名:https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1)
# 服务间内部密钥:gateway 提供方请求会带 X-Account-Id + X-Internal-Secret,
# 由 llm-gateway 据此解析该账号的 BYOK 密钥;必须与 account-service /
# llm-gateway 的 INTERNAL_SECRET 一致。留空则只按平台默认密钥解析
# (生产 gateway 模式必须配置;dev 默认值与 account 示例保持一致)。
# KNOWLEDGE__INTERNAL_SECRET=dev-internal-secret

# 重排(可选,默认关闭;开启后混合检索多一轮精排):
#   none    = 不重排,直接用 RRF 粗排顺序(响应 rerank=null)
#   gateway = 经 llm-gateway /v1/rerank 精排(百炼 qwen3-rerank 等);
#             网关失败自动降级回 RRF 顺序并回 rerank="skipped",不会 5xx
# 先取 max(limit, RERANK_CANDIDATES) 条候选再重排,截回 limit;
# 分数随之变成重排相关性分数(0~1),与 RRF 融合分不可混用。
KNOWLEDGE__RERANK_PROVIDER=none
KNOWLEDGE__RERANK_MODEL=dashscope/qwen3-rerank
KNOWLEDGE__RERANK_CANDIDATES=20
KNOWLEDGE__RERANK_TIMEOUT_SECONDS=20.0
# 百炼重排示例:
#   KNOWLEDGE__RERANK_PROVIDER=gateway
#   KNOWLEDGE__RERANK_MODEL=dashscope/qwen3-rerank
# 网关侧重排凭据留空会回退 EMBEDDING_API_KEY/API_BASE(百炼嵌入与重排同源)。

# 分块与检索
KNOWLEDGE__CHUNK_SIZE=400
KNOWLEDGE__CHUNK_OVERLAP=60
KNOWLEDGE__SEARCH_DEFAULT_LIMIT=5

# 鉴权(架构 §10):与其他服务同一套 token→账号约定(默认开启,自建 IdP)
KNOWLEDGE__AUTH_ENABLED=true
KNOWLEDGE__AUTH_ISSUER=http://127.0.0.1:8001
KNOWLEDGE__AUTH_AUDIENCE=beauty-api
# KNOWLEDGE__AUTH_JWKS_URL=  # 不填走 OIDC 发现文档
# KNOWLEDGE__AUTH_ACCOUNT_CLAIM=account_id

# ── 观测:Langfuse(docs/design/langfuse-observability.md) ──
# 上报范围(2026-11-11 起):只有 agent-orchestrator 与 llm-gateway 直连 Langfuse;
# 本服务只建 span、传播 traceparent(TRACING_ENABLED=true),不导出。
# 留空/ENABLED=false = 完全不上报(零网络)。用 Cloud 时:填项目密钥 + 下面的 HOST。
# 用自托管观测 profile 时 HOST=http://localhost:3001,密钥用 pk-lf-beauty/sk-lf-beauty。
KNOWLEDGE__LANGFUSE_ENABLED=false
KNOWLEDGE__LANGFUSE_HOST=https://cloud.langfuse.com
KNOWLEDGE__LANGFUSE_PUBLIC_KEY=
KNOWLEDGE__LANGFUSE_SECRET_KEY=
