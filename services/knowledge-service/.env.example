# knowledge-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
KNOWLEDGE__ENV=dev
KNOWLEDGE__LOG_LEVEL=INFO

# ── 可观测(日志/指标/追踪/错误聚合,规范见 docs/observability.md)──────────────
# 访问日志:每请求一行 http_request 带 request_id/trace_id/route/status/duration_ms;
# 探针(/healthz、/readyz)降到 debug,慢请求另打一行 http_request_slow
KNOWLEDGE__ACCESS_LOG_ENABLED=true
KNOWLEDGE__SLOW_REQUEST_MS=1500
# 强制 JSON 日志(dev 默认人读彩色;staging/prod 固定 JSON)
# KNOWLEDGE__LOG_JSON=true
# Prometheus 指标端点 GET /internal/metrics(不经 BFF);配了令牌则抓取必须带
# X-Metrics-Token 或 Authorization: Bearer
KNOWLEDGE__METRICS_ENABLED=true
# KNOWLEDGE__METRICS_TOKEN=
# Sentry 错误聚合:DSN 留空即完全不初始化(内网形态零副作用);业务 4xx 不入 Sentry
# KNOWLEDGE__SENTRY_DSN=
# KNOWLEDGE__SENTRY_RELEASE=
KNOWLEDGE__SENTRY_TRACES_SAMPLE_RATE=0
# OTel 追踪:OTLP_ENDPOINT 留空则零出口(span 只用于日志 trace_id 串联,不发网络);
# 填完整 …/v1/traces 地址才按 OTLP/HTTP 导出;采样由入口决定、下游跟随
# KNOWLEDGE__OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# KNOWLEDGE__OTLP_HEADERS={"x-honeycomb-team":"…"}
KNOWLEDGE__TRACING_ENABLED=true
KNOWLEDGE__TRACE_SAMPLE_RATIO=0.1

# 方式一(零依赖):sqlite + 直建表(测试即此路径)
KNOWLEDGE__DATABASE_URL=sqlite+aiosqlite:///./knowledge.db
KNOWLEDGE__AUTO_CREATE_TABLES=true

# 方式二(贴近生产):compose 起 postgres 后先迁移再启动
#   docker compose -f deploy/docker-compose.yml up -d postgres
#   cd services/knowledge-service
#   KNOWLEDGE__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty uv run alembic upgrade head

# 嵌入提供方(架构 §5 唯一出口):
#   local   = 无依赖确定性词法近似向量(dev/测试;可跑通全链路,但不是语义嵌入)
#   gateway = 经 llm-gateway /v1/embeddings(生产;模型密钥由网关进程提供)
KNOWLEDGE__EMBEDDING_PROVIDER=local
KNOWLEDGE__EMBEDDING_MODEL=bge-m3
KNOWLEDGE__LLM_GATEWAY_URL=http://127.0.0.1:8003

# 分块与检索
KNOWLEDGE__CHUNK_SIZE=400
KNOWLEDGE__CHUNK_OVERLAP=60
KNOWLEDGE__SEARCH_DEFAULT_LIMIT=5

# 鉴权(架构 §10):与其他服务同一套 token→租户约定(默认开启,自建 IdP)
KNOWLEDGE__AUTH_ENABLED=true
KNOWLEDGE__AUTH_ISSUER=http://127.0.0.1:8001
KNOWLEDGE__AUTH_AUDIENCE=beauty-api
# KNOWLEDGE__AUTH_JWKS_URL=  # 不填走 OIDC 发现文档
# KNOWLEDGE__AUTH_TENANT_CLAIM=tenant_id
