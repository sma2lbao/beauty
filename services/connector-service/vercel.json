{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --active --no-dev --no-editable --package connector-service --frozen",
  "buildCommand": "true",
  "functions": {
    "connector/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,**/test_*.py,**/__pycache__/**,**/*.db,**/.pytest_cache/**,**/*.egg-info/**,reports/**,coverage/**}"
    }
  }
}
