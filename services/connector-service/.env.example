# connector-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
CONNECTOR__ENV=dev
CONNECTOR__LOG_LEVEL=INFO

# ── 可观测(日志/指标/追踪/错误聚合,规范见 docs/observability.md)──────────────
# 访问日志:每请求一行 http_request 带 request_id/trace_id/route/status/duration_ms;
# 探针(/healthz、/readyz)降到 debug,慢请求另打一行 http_request_slow
CONNECTOR__ACCESS_LOG_ENABLED=true
CONNECTOR__SLOW_REQUEST_MS=1500
# 强制 JSON 日志(dev 默认人读彩色;staging/prod 固定 JSON)
# CONNECTOR__LOG_JSON=true
# Prometheus 指标端点 GET /internal/metrics(不经 API 网关);配了令牌则抓取必须带
# X-Metrics-Token 或 Authorization: Bearer
CONNECTOR__METRICS_ENABLED=true
# CONNECTOR__METRICS_TOKEN=
# Sentry 错误聚合:DSN 留空即完全不初始化(内网形态零副作用);业务 4xx 不入 Sentry
# CONNECTOR__SENTRY_DSN=
# CONNECTOR__SENTRY_RELEASE=
CONNECTOR__SENTRY_TRACES_SAMPLE_RATE=0
# OTel 追踪:OTLP_ENDPOINT 留空则零出口(span 只用于日志 trace_id 串联,不发网络);
# 填完整 …/v1/traces 地址才按 OTLP/HTTP 导出;采样由入口决定、下游跟随
# CONNECTOR__OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# CONNECTOR__OTLP_HEADERS={"x-honeycomb-team":"…"}
CONNECTOR__TRACING_ENABLED=true
CONNECTOR__TRACE_SAMPLE_RATIO=0.1

# ── 连接器平台 ────────────────────────────────────────────────────────────
# 启用的 provider(逗号分隔)。代码里没有 manifest 的名字会被忽略。
# 仓库内置 Notion 只读连接器;不启用时目录不出现该 provider。
CONNECTOR__PROVIDERS_ENABLED=notion
# 服务间内部调用鉴权(tool-service → 目录/执行端点):X-Internal-Secret。
# 留空 = 内部端点整体关闭(一律 401 connector.internal_forbidden)。
# 必须与 tool-service 的 TOOL__CONNECTOR_INTERNAL_SECRET 一致。
CONNECTOR__INTERNAL_SECRET=
# OAuth 回调基址:redirect_uri = {base}/v1/oauth/{provider}/callback,
# 必须与 provider 后台登记的「重定向 URL」逐字一致。
CONNECTOR__OAUTH_REDIRECT_BASE=http://127.0.0.1:8004
# 授权结束后 302 回前端的地址(附 provider/status/connection_id|code 查询参数)。
CONNECTOR__OAUTH_SUCCESS_REDIRECT=http://127.0.0.1:5173/connectors
# 一次性授权会话 TTL(秒)与 access token 提前刷新余量(秒)。
CONNECTOR__OAUTH_SESSION_TTL_SECONDS=600
CONNECTOR__REFRESH_MARGIN_SECONDS=300
CONNECTOR__REQUEST_TIMEOUT_SECONDS=10
# 连接生命周期事件(outbox):created/expired/revoked 与状态变更同事务写表;
# 默认关闭时降级为结构化日志 connection_event,不写库。
# 开启后由后台 OutboxDispatcher 至少一次投递(消费方需按事件 id 去重)。
# CONNECTOR__OUTBOX_ENABLED=true
CONNECTOR__OUTBOX_ENABLED=false
CONNECTOR__OUTBOX_DISPATCH_INTERVAL_SECONDS=1
CONNECTOR__OUTBOX_BATCH_SIZE=50
CONNECTOR__OUTBOX_MAX_ATTEMPTS=5
# 24h 刷新巡检:扫描 active+enabled 且 last_refreshed_at 为空或早于
# now - REFRESH_STALE_SECONDS 的连接,逐条在独立事务里走单飞刷新。
# 生产开启;测试环境关闭(避免后台任务与真实上游)。
CONNECTOR__REFRESH_PATROL_ENABLED=true
CONNECTOR__REFRESH_PATROL_INTERVAL_SECONDS=3600
CONNECTOR__REFRESH_STALE_SECONDS=86400

# ── 内置 Notion provider ─────────────────────────────────────────────────
# 在 https://www.notion.so/my-integrations 建 public integration,Redirect URI 填
# {OAUTH_REDIRECT_BASE}/v1/oauth/notion/callback(经网关时为
# http://127.0.0.1:5173/api/connector/v1/oauth/notion/callback);
# 未配置时目录里 configured=false,授权接口返回 409 provider_not_configured。
CONNECTOR__NOTION_CLIENT_ID=
CONNECTOR__NOTION_CLIENT_SECRET=
# 每个 Notion API 请求带的版本头(只对新版本不兼容变更敏感,加性变更通用)。
CONNECTOR__NOTION_VERSION=2026-03-11
CONNECTOR__NOTION_API_BASE=https://api.notion.com
# 多租户可用 tenant_apps 表按租户覆盖 app_id=client_id / app_secret=client_secret
# (见 README「租户级应用凭证」)。

# 方式一(零依赖):sqlite + 直建表(测试即此路径)
CONNECTOR__DATABASE_URL=sqlite+aiosqlite:///./connector.db
CONNECTOR__AUTO_CREATE_TABLES=true

# 方式二(贴近生产):compose 起 postgres 后先迁移再启动——
#   docker compose -f deploy/docker-compose.yml up -d postgres
#   cd services/connector-service
#   CONNECTOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty uv run alembic upgrade head
# (注意:与 agent-orchestrator 共用 beauty 库,表名不冲突,迁移链各自独立)
# CONNECTOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty

# 鉴权(架构 §10):与 agent-orchestrator 同一套 token→租户约定(默认开启);
# 调用方是 orchestrator 经 TokenBroker 换发的 Bearer token(内部签发密钥见
# account 的 ACCOUNT__INTERNAL_SECRET);自建 IdP 即 account-service(:8001)
CONNECTOR__AUTH_ENABLED=true
CONNECTOR__AUTH_ISSUER=http://127.0.0.1:8001
CONNECTOR__AUTH_AUDIENCE=beauty-api
# CONNECTOR__AUTH_JWKS_URL=  # 不填走 OIDC 发现文档
# CONNECTOR__AUTH_TENANT_CLAIM=tenant_id

# 连接凭证应用层加密密钥(生产必须换随机长密钥/KMS)
CONNECTOR__CREDENTIAL_SECRET=dev-connector-secret-change-me
