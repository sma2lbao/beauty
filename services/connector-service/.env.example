# connector-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
CONNECTOR__ENV=dev
CONNECTOR__LOG_LEVEL=INFO

# 方式一(零依赖):sqlite + 直建表(测试即此路径)
CONNECTOR__DATABASE_URL=sqlite+aiosqlite:///./connector.db
CONNECTOR__AUTO_CREATE_TABLES=true

# 方式二(贴近生产):compose 起 postgres 后先迁移再启动——
#   docker compose -f deploy/docker-compose.yml up -d postgres
#   cd services/connector-service
#   CONNECTOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty uv run alembic upgrade head
# (注意:与 agent-orchestrator 共用 beauty 库,表名不冲突,迁移链各自独立)
# CONNECTOR__DATABASE_URL=postgresql+asyncpg://beauty:beauty@localhost:5432/beauty
