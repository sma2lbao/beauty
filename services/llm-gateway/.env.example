# llm-gateway 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
LLM_GATEWAY__ENV=dev
LLM_GATEWAY__LOG_LEVEL=INFO

# ── 可观测(日志/指标/追踪/错误聚合,规范见 docs/observability.md)──────────────
# 访问日志:每请求一行 http_request 带 request_id/trace_id/route/status/duration_ms;
# 探针(/healthz、/readyz)降到 debug,慢请求另打一行 http_request_slow
LLM_GATEWAY__ACCESS_LOG_ENABLED=true
LLM_GATEWAY__SLOW_REQUEST_MS=1500
# 强制 JSON 日志(dev 默认人读彩色;staging/prod 固定 JSON)
# LLM_GATEWAY__LOG_JSON=true
# Prometheus 指标端点 GET /internal/metrics(不经 BFF);配了令牌则抓取必须带
# X-Metrics-Token 或 Authorization: Bearer
LLM_GATEWAY__METRICS_ENABLED=true
# LLM_GATEWAY__METRICS_TOKEN=
# Sentry 错误聚合:DSN 留空即完全不初始化(内网形态零副作用);业务 4xx 不入 Sentry
# LLM_GATEWAY__SENTRY_DSN=
# LLM_GATEWAY__SENTRY_RELEASE=
LLM_GATEWAY__SENTRY_TRACES_SAMPLE_RATE=0
# OTel 追踪:OTLP_ENDPOINT 留空则零出口(span 只用于日志 trace_id 串联,不发网络);
# 填完整 …/v1/traces 地址才按 OTLP/HTTP 导出;采样由入口决定、下游跟随
# LLM_GATEWAY__OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# LLM_GATEWAY__OTLP_HEADERS={"x-honeycomb-team":"…"}
LLM_GATEWAY__TRACING_ENABLED=true
LLM_GATEWAY__TRACE_SAMPLE_RATIO=0.1
# 联调:开启后把模型请求 messages 与响应正文(各截断 2KB)打进 llm_content 日志,
# 只应在本地临时开(prompt 可能含用户数据与工具结果)
# LLM_GATEWAY__LOG_CONTENT=true
# litellm 路由格式 provider/model(见 https://docs.litellm.ai/docs/providers)
LLM_GATEWAY__DEFAULT_MODEL=deepseek/deepseek-chat

# 提供商凭据:显式传给 litellm(推荐;.env 也会被读取);
# 配了 BYOK 且租户有 key 时,租户 key 覆盖 API_KEY,API_BASE 仍用这里
# LLM_GATEWAY__API_KEY=sk-...
# LLM_GATEWAY__API_BASE=https://api.deepseek.com
# 也可继续用 litellm 原生环境变量(需导出到进程环境):
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# 模型列表(M0-11):留空时只返回 DEFAULT_MODEL;示例打开两个 deepseek 路由
LLM_GATEWAY__AVAILABLE_MODELS=["deepseek/deepseek-chat","deepseek/deepseek-reasoner"]

# ── BYOK(按租户注入密钥;见 README「BYOK」)──────────────────────────────────
# 解析地址:网关向 GET /v1/byok/{provider}/secret 换租户密钥
LLM_GATEWAY__ACCOUNT_BASE_URL=http://127.0.0.1:8001
# 服务间共享密钥(X-Internal-Secret):同时是内部鉴权与 BYOK 的总开关。
# 留空 = BYOK 停用 + 模型端点不鉴权(仅本地 dev);生产必须配,否则内网任意进程都能调模型
# LLM_GATEWAY__INTERNAL_SECRET=change-me-shared-secret
LLM_GATEWAY__BYOK_ENABLED=true
# 正缓存 TTL(秒):也决定密钥轮换在多长时间内被网关看到
LLM_GATEWAY__BYOK_CACHE_TTL_SECONDS=300
# 负缓存 TTL(秒):租户没配 key(404)时的短缓存
LLM_GATEWAY__BYOK_NEGATIVE_CACHE_TTL_SECONDS=30
# 缓存条目上限(按租户+provider,LRU 淘汰)
LLM_GATEWAY__BYOK_CACHE_MAX_ENTRIES=1024
# 解析 account 的超时(秒):超时即回退平台 key
LLM_GATEWAY__ACCOUNT_TIMEOUT_SECONDS=5
