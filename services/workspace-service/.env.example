# workspace-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
WORKSPACE__ENV=dev
WORKSPACE__LOG_LEVEL=INFO

WORKSPACE__DATABASE_URL=sqlite+aiosqlite:///./workspace.db
WORKSPACE__AUTO_CREATE_TABLES=true

# 交付物内容存储(§7):database = 内容在 DB 列;filesystem = 落对象存储目录
WORKSPACE__ARTIFACT_STORE=filesystem
WORKSPACE__ARTIFACT_ROOT=./.artifacts

# 鉴权(架构 §10):与其他服务同一套 token→租户约定(默认开启,自建 IdP)
WORKSPACE__AUTH_ENABLED=true
WORKSPACE__AUTH_ISSUER=http://127.0.0.1:8001
WORKSPACE__AUTH_AUDIENCE=beauty-api
# WORKSPACE__AUTH_JWKS_URL=  # 不填走 OIDC 发现文档
# WORKSPACE__AUTH_TENANT_CLAIM=tenant_id
