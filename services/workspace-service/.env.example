# workspace-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
WORKSPACE__ENV=dev
WORKSPACE__LOG_LEVEL=INFO

WORKSPACE__DATABASE_URL=sqlite+aiosqlite:///./workspace.db
WORKSPACE__AUTO_CREATE_TABLES=true

# 交付物内容存储(§7):database = 内容在 DB 列;filesystem = 落对象存储目录
WORKSPACE__ARTIFACT_STORE=filesystem
WORKSPACE__ARTIFACT_ROOT=./.artifacts
# 通用二进制对象(skill 包)单对象大小上限,默认 20MB
# WORKSPACE__OBJECT_MAX_BYTES=20971520

# 沙箱(provider 默认 microsandbox;orchestrator 的 stdio MCP 与技能包执行依赖它):
# runtime 由 SDK 自带,MSB_HOME 只是 runtime 缓存/DB 目录(默认 ~/.microsandbox)。
# 注意:runtime 派生的 Unix socket 必须短于 104 字节,所以 MSB_HOME 不要设成
# 仓库内长路径(实测会报 sandbox runtime socket path is too long),保持默认即可,
# 或指向 /tmp 下的短目录。
# WORKSPACE__SANDBOX_MSB_HOME=/tmp/msb
# 首次创建沙箱会从 OCI registry 拉镜像(SANDBOX_DEFAULT_IMAGE,默认 python 别名);
# 离线/受限网络时设为本地 rootfs 目录的绝对路径(需含 /usr/bin/python3)。
# WORKSPACE__SANDBOX_DEFAULT_IMAGE=/absolute/path/to/rootfs-python

# 鉴权(架构 §10):与其他服务同一套 token→租户约定(默认开启,自建 IdP)
WORKSPACE__AUTH_ENABLED=true
WORKSPACE__AUTH_ISSUER=http://127.0.0.1:8001
WORKSPACE__AUTH_AUDIENCE=beauty-api
# WORKSPACE__AUTH_JWKS_URL=  # 不填走 OIDC 发现文档
# WORKSPACE__AUTH_TENANT_CLAIM=tenant_id
