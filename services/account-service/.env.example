# account-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
ACCOUNT__ENV=dev
ACCOUNT__LOG_LEVEL=INFO

ACCOUNT__DATABASE_URL=sqlite+aiosqlite:///./account.db
ACCOUNT__AUTO_CREATE_TABLES=true

# 鉴权(架构 §10):认证本身交给 IdP(Logto);
# 本服务也用同一套 token→租户约定确定"当前组织/租户"
ACCOUNT__AUTH_ENABLED=false
ACCOUNT__AUTH_ISSUER=http://127.0.0.1:3301/oidc
# ACCOUNT__AUTH_AUDIENCE=beauty-api
# ACCOUNT__AUTH_JWKS_URL=https://idp.example.com/oidc/jwks  # 不填走发现文档
# ACCOUNT__AUTH_TENANT_CLAIM=tenant_id

# dev IdP 桩(README「dev IdP 桩」一节):开桩后本服务兼作签发方。
# 全套开启示例(其余服务 AUTH_ISSUER 指向本服务):
#   ACCOUNT__AUTH_ENABLED=true
#   ACCOUNT__AUTH_ISSUER=http://127.0.0.1:8001
#   ACCOUNT__AUTH_AUDIENCE=beauty-api
#   ACCOUNT__DEV_AUTH_ENABLED=true
# 内部服务签发密钥(POST /v1/auth/issue 的 X-Internal-Secret):
# 与 agent-orchestrator 的 AGENT_ORCHESTRATOR__INTERNAL_AUTH_SECRET 一致;
# 留空即关闭内部签发端点
ACCOUNT__DEV_AUTH_ENABLED=false
# ACCOUNT__DEV_INTERNAL_SECRET=
