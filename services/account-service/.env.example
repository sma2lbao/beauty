# account-service 本地开发配置(复制为 .env;.env 不提交,见 AGENTS.md)
ACCOUNT__ENV=dev
ACCOUNT__LOG_LEVEL=INFO

ACCOUNT__DATABASE_URL=sqlite+aiosqlite:///./account.db
ACCOUNT__AUTO_CREATE_TABLES=true

# 鉴权(架构 §10):本服务即自建 IdP,issuer 指向自身,默认已对齐;
# 换托管 IdP(Logto)时改 ISSUER/JWKS,其余服务同步改
ACCOUNT__AUTH_ENABLED=true
ACCOUNT__AUTH_ISSUER=http://127.0.0.1:8001
ACCOUNT__AUTH_AUDIENCE=beauty-api

# 签名密钥持久化(PEM,生产必设):设置后跨重启不轮换 kid;留空则进程内生成,
# 重启后已签发的未过期 access token 全部失效(前端自动刷新令牌即可续期)
# ACCOUNT__SIGNING_KEY_PATH=./signing-key.pem

# 内部服务签发密钥(POST /v1/auth/issue 的 X-Internal-Secret):与
# agent-orchestrator 的 AGENT_ORCHESTRATOR__INTERNAL_AUTH_SECRET 一致;
# 留空即关闭内部签发端点(orchestrator 的工具/镜像联动不可用)
# ACCOUNT__INTERNAL_SECRET=

# 社交 OAuth(M0-05):client id/secret 留空即该 provider 关闭;
# OAUTH_STATE_SECRET 留空回退 INTERNAL_SECRET,两者都空则 OAuth 关闭
# ACCOUNT__OAUTH_STATE_SECRET=
# ACCOUNT__GOOGLE_CLIENT_ID=
# ACCOUNT__GOOGLE_CLIENT_SECRET=
# ACCOUNT__GITHUB_CLIENT_ID=
# ACCOUNT__GITHUB_CLIENT_SECRET=

# BYOK 应用层加密密钥(M0-11 占位;生产换随机长密钥)
# ACCOUNT__BYOK_SECRET=dev-byok-secret-change-me
