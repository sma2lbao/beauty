# bff 本地开发配置(复制为 .env;.env 不提交)
BFF__ENV=dev
BFF__LOG_LEVEL=INFO

# ── 可观测(日志/指标/追踪/错误聚合,规范见 docs/observability.md)──────────────
# 访问日志:每请求一行 http_request 带 request_id/trace_id/route/status/duration_ms;
# 探针(/healthz、/readyz)降到 debug,慢请求另打一行 http_request_slow
BFF__ACCESS_LOG_ENABLED=true
BFF__SLOW_REQUEST_MS=1500
# 强制 JSON 日志(dev 默认人读彩色;staging/prod 固定 JSON)
# BFF__LOG_JSON=true
# Prometheus 指标端点 GET /internal/metrics(不经 BFF);配了令牌则抓取必须带
# X-Metrics-Token 或 Authorization: Bearer
BFF__METRICS_ENABLED=true
# BFF__METRICS_TOKEN=
# Sentry 错误聚合:DSN 留空即完全不初始化(内网形态零副作用);业务 4xx 不入 Sentry
# BFF__SENTRY_DSN=
# BFF__SENTRY_RELEASE=
BFF__SENTRY_TRACES_SAMPLE_RATE=0
# OTel 追踪:OTLP_ENDPOINT 留空则零出口(span 只用于日志 trace_id 串联,不发网络);
# 填完整 …/v1/traces 地址才按 OTLP/HTTP 导出;采样由入口决定、下游跟随
# BFF__OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# BFF__OTLP_HEADERS={"x-honeycomb-team":"…"}
BFF__TRACING_ENABLED=true
BFF__TRACE_SAMPLE_RATIO=0.1

# 允许的前端 Origin(同源部署时仅用于本地跨端口调试)
BFF__APP_ORIGIN=http://localhost:5173

# 内部服务地址(M0-06 代理使用)
BFF__RUNTIME_BASE_URL=http://127.0.0.1:8002
BFF__ACCOUNT_BASE_URL=http://127.0.0.1:8001
BFF__WORKSPACE_BASE_URL=http://127.0.0.1:8005
BFF__KNOWLEDGE_BASE_URL=http://127.0.0.1:8006
BFF__CONNECTOR_BASE_URL=http://127.0.0.1:8004
BFF__LLM_GATEWAY_BASE_URL=http://127.0.0.1:8003
BFF__RUNTIME_PUBLIC_URL=http://127.0.0.1:8002

# M0-05 会话 Cookie;生产必须换成随机长密钥,HTTPS 下 COOKIE_SECURE=true
BFF__SESSION_SECRET=dev-bff-session-secret-change-me
BFF__COOKIE_SECURE=false
BFF__COOKIE_NAME=bm_session
BFF__COOKIE_TTL_SECONDS=604800

# stream token(M0-06):与 account-service 的 INTERNAL_SECRET 一致;留空则 503
BFF__INTERNAL_SECRET=dev-internal-secret
# 进程内限流;Redis 接入后替换
BFF__RATE_LIMIT_PER_MINUTE=120
