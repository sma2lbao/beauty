# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
# Next.js 官网构建产物(apps/site)
apps/site/.next/
apps/site/out/
# TypeScript 增量构建信息（root/packages 的 composite 工程均会产出）
*.tsbuildinfo
# 例外说明: apps/site/next-env.d.ts 是 Next.js 官方要求提交的类型引导文件,
# 虽由 next dev/build 生成但不属于构建产物,scripts/check-workspace.sh 的生成物
# 检查把它列入例外清单 —— 不要把它加入 ignore。
# Rspress 文档站构建产物（packages/design/rspress.config.ts 的 outDir）
doc_build

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
test-output/
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.npm-cache/
.uv-cache/
.uv-python/
.cache/

# 本地运行时的 sqlite 库与产物目录(服务目录直写,dev 起法生成)
services/*/*.db
services/*/migrations/*.db
services/*/.artifacts/
# local 沙箱 provider 的宿主目录(workspace-service 默认 ./.sandboxes)
services/*/.sandboxes/
# 仓库根也曾残留散落 db(W3 实测 connector.db/workspace.db);只匹配根级,不误伤深层路径
/*.db
.claude/worktrees
.claude/settings.local.json

vitest.config.*.timestamp*

# Python / uv
.venv
.env
/reports
__pycache__/
.ruff_cache
*.egg-info
# pytest / ruff 缓存
.pytest_cache/
.ruff_cache/
# pytest-cov
.coverage
coverage.xml
htmlcov/

# Playwright MCP 运行时产物（控制台日志、页面快照），非源码
.playwright-mcp/

# agent 视觉自检产物（DOM 快照、截图），非源码
.qa/

# Electron/Chromium 运行时产物（单实例锁、socket），非源码
apps/desktop/Singleton*
apps/desktop/chrome_debug.log
