{
  // W2 R-21:统一 extends 根 tsconfig.base.json(strict/skipLibCheck/isolatedModules/
  // target/customConditions 都在 base)。
  // 本文件只留 Next.js 的有意差异:bundler 解析、esModuleInterop、incremental、
  // next 插件、DOM lib 与站点路径别名。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".next"
  ],
  "references": [
    {
      "path": "../../packages/console-ui"
    },
    {
      "path": "../../packages/design"
    }
  ]
}
