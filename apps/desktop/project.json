{
  "name": "@beauty/desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "npm run build", "cwd": "apps/desktop" },
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "apps/desktop" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run start", "cwd": "apps/desktop" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run typecheck", "cwd": "apps/desktop" },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": { "command": "npm run test", "cwd": "apps/desktop" },
      "cache": true
    },
    "package:dir": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run package:dir", "cwd": "apps/desktop" }
    }
  },
  "tags": []
}
