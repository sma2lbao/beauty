{
  // W2 R-21:统一 extends 根 tsconfig.base.json(strict/lib/customConditions/
  // noUnusedLocals/noFallthroughCasesInSwitch/skipLibCheck 都在 base)。
  // 本文件只留 Electron/Vite 的有意差异:bundler 解析、DOM、jsx、types、别名。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedParameters": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/renderer", "src/shared", "vite.renderer.config.mts"],
  "references": [
    {
      "path": "../../packages/design"
    },
    {
      "path": "../../packages/console-ui"
    }
  ]
}
