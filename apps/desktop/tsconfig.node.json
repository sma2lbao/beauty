{
  // W2 R-21:统一 extends 根 tsconfig.base.json(strict/noUnusedLocals/
  // noFallthroughCasesInSwitch/skipLibCheck 都在 base)。
  // 主/预加载进程是纯 node 环境:lib 不含 DOM,bundler 解析,types=node。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "vite.main.config.mts",
    "vite.preload.config.mts"
  ]
}
