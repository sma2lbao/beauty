{
  "name": "@beauty/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "beauty moon 桌面应用:本地电脑模式(本机会话、本机文件、本机命令执行)",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "build:electron": "vite build --config vite.main.config.mts && vite build --config vite.preload.config.mts",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.mts && vitest run --config vitest.node.config.mts",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.mjs --dir"
  },
  "dependencies": {
    "@beauty/console-ui": "*",
    "@beauty/design": "*",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@beauty/eslint-config": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "~5.0.5"
  }
}
