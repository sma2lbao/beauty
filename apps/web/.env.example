# apps/web 构建期环境变量(Vite 只暴露 VITE_ 前缀;复制为 .env.local 使用)

# 后端基址:留空走同源(Vite dev 已把 /api 代理到 agent-orchestrator :8002)
# VITE_RUNS_API_URL=http://127.0.0.1:8002

# 知识库后端基址:留空走同源(Vite dev 把 /knowledge-api 代理到 knowledge-service :8006)
# VITE_KNOWLEDGE_API_URL=http://127.0.0.1:8006

# 账号后端基址:留空走同源(Vite dev 把 /account-api 代理到 account-service :8001)
# VITE_ACCOUNT_API_URL=http://127.0.0.1:8001

# 工作区后端基址:留空走同源(Vite dev 把 /workspace-api 代理到 workspace-service :8005)
# VITE_WORKSPACE_API_URL=http://127.0.0.1:8005

# 鉴权模式:
#   dev(默认) 后端 AUTH_ENABLED=false 时用 X-Tenant-Id 临时头
#   token     自建认证:account-service 邮箱+密码登录/注册(登录页),
#             双令牌存本地,access 过期自动用 refresh 续(旋转式);
#             运维/联调仍可粘贴纯 access token(不自动续期)
#   logto     Logto 授权码 + PKCE 登录(SDK 自动续期)
VITE_AUTH_MODE=dev
VITE_TENANT_ID=demo-tenant

# logto 模式必填;回调地址需在 Logto 控制台登记为 <origin>/callback
# VITE_LOGTO_ENDPOINT=https://your-tenant.logto.app
# VITE_LOGTO_APP_ID=your-app-id
# VITE_LOGTO_RESOURCE=https://api.beauty.example   # 可选:API resource 指示器
