# 生产构建（`vite build`，mode=production）默认值。
#
# 必须用 session 模式：token 模式会直连 `/account-api`、`/workspace-api`、
# `/knowledge-api` 三个 dev 代理前缀，而生产只有 Vercel 的 `/api/:path*`
# rewrite（dev 前缀见 vite.config.ts，仅本地 dev server 生效）。
VITE_AUTH_MODE=session

# 官网地址；不设置时生产默认 https://site.beautymoon.cn（见 src/config/env.ts）。
VITE_SITE_URL=https://site.beautymoon.cn
