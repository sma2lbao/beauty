{
  // W2 R-21:统一 extends 根 tsconfig.base.json(strict/target/lib(es2022)/customConditions/
  // noUnusedLocals/noFallthroughCasesInSwitch/skipLibCheck/isolatedModules 都在 base)。
  // 本文件只留 Vite 应用的有意差异:bundler 解析、DOM 环境、jsx、路径别名。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/design"
    },
    {
      "path": "../../packages/console-ui"
    }
  ]
}
