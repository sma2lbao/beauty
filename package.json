  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "dev": "bash scripts/dev.sh",
    "dev:site": "bash scripts/dev.sh --site",
    "dev:status": "bash scripts/dev.sh --status",
    "dev:reset": "bash scripts/reset-local.sh",
    "dev:seed": "bash scripts/seed-local.sh",
    "test": "nx run-many -t test --projects=@beauty/web,@beauty/desktop,@beauty/design -- --run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "bash scripts/check-docs.sh",
    "gate": "bash scripts/refactor-gate.sh",
    "golden": "bash scripts/golden-run/golden-run.sh"
  },
  "private": true,
  "devDependencies": {
    "@nx/eslint": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nxlv/python": "^23.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "eslint": "^9.0.0",
    "nx": "23.2.1",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=22.22.2"
