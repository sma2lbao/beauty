# 腾讯云轻量（首尔）生产环境变量样例。
# 复制为 deploy/tencent/.env 后逐项替换；.env 已被 git 忽略，禁止提交真实密钥。
# 注意：文件名是 .env（不是 .env.production），compose 以 env_file: .env 注入全部服务。

# ── 镜像 ─────────────────────────────────────────────────────────────────────
# 由本地/CI 以 --platform linux/amd64 构建并推送 TCR 后填写：
#   docker build --platform linux/amd64 -f deploy/docker/python-service.Dockerfile \
#     --build-arg SERVICE=api-gateway -t $REGISTRY/beauty/python-service:$TAG .
REGISTRY=ccr.ccs.tencentyun.com/beauty
TAG=change-me

# ── 入口域名 ─────────────────────────────────────────────────────────────────
# DNS A 记录已指向本机公网 IP；Caddy 自动申请证书
API_HOST=api-cvm.beautymoon.cn

# ── 数据库（Neon，6 库，一服务一库）─────────────────────────────────────────
# 用 pooler 端点（主机名带 -pooler）；asyncpg + PgBouncer 事务模式需
# statement_cache_size=0，见 docs/design/hybrid-deployment.md §3.5。
# 首尔最近的是 Neon Singapore（ap-southeast-1），RTT 约 70–90ms。
ACCOUNT__DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/beauty_account?ssl=require
AGENT_ORCHESTRATOR__DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/beauty_agent?ssl=require
CONNECTOR__DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/beauty_connector?ssl=require
KNOWLEDGE__DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/beauty_knowledge?ssl=require
WORKSPACE__DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/beauty_workspace?ssl=require
TOOL__DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/beauty_tool?ssl=require

# 迁移/建表一律关闭，生产由 alembic 负责
ACCOUNT__AUTO_CREATE_TABLES=false
AGENT_ORCHESTRATOR__AUTO_CREATE_TABLES=false
CONNECTOR__AUTO_CREATE_TABLES=false
KNOWLEDGE__AUTO_CREATE_TABLES=false
WORKSPACE__AUTO_CREATE_TABLES=false
TOOL__AUTO_CREATE_TABLES=false

# ── 鉴权（自建 IdP：account-service）────────────────────────────────────────
ACCOUNT__AUTH_ENABLED=true
ACCOUNT__AUTH_ISSUER=https://api-cvm.beautymoon.cn
ACCOUNT__SIGNING_KEY_PATH=/data/keys/account-signing-key.pem
# 与 gateway/orchestrator/llm-gateway/knowledge/tool 的 INTERNAL_SECRET 同值
ACCOUNT__INTERNAL_SECRET=CHANGE-ME-hex32
ACCOUNT__OAUTH_STATE_SECRET=CHANGE-ME-hex32
ACCOUNT__OAUTH21_WEB_ORIGIN=https://app.beautymoon.cn

AGENT_ORCHESTRATOR__AUTH_ENABLED=true
AGENT_ORCHESTRATOR__AUTH_ISSUER=https://api-cvm.beautymoon.cn
AGENT_ORCHESTRATOR__INTERNAL_AUTH_SECRET=CHANGE-ME-hex32

CONNECTOR__AUTH_ENABLED=true
CONNECTOR__AUTH_ISSUER=https://api-cvm.beautymoon.cn
KNOWLEDGE__AUTH_ENABLED=true
KNOWLEDGE__AUTH_ISSUER=https://api-cvm.beautymoon.cn
TOOL__AUTH_ENABLED=true
TOOL__AUTH_ISSUER=https://api-cvm.beautymoon.cn
WORKSPACE__AUTH_ENABLED=true
WORKSPACE__AUTH_ISSUER=https://api-cvm.beautymoon.cn

# ── API 网关 ────────────────────────────────────────────────────────────────
API_GATEWAY__APP_ORIGIN=https://app.beautymoon.cn
API_GATEWAY__RUNTIME_PUBLIC_URL=https://api-cvm.beautymoon.cn
API_GATEWAY__COOKIE_SECURE=true
API_GATEWAY__SESSION_SECRET=CHANGE-ME-hex32
API_GATEWAY__INTERNAL_SECRET=CHANGE-ME-hex32
API_GATEWAY__RUNTIME_BASE_URL=http://agent-orchestrator:8002
API_GATEWAY__ACCOUNT_BASE_URL=http://account-service:8001
API_GATEWAY__WORKSPACE_BASE_URL=http://workspace-service:8005
API_GATEWAY__KNOWLEDGE_BASE_URL=http://knowledge-service:8006
API_GATEWAY__CONNECTOR_BASE_URL=http://connector-service:8004
API_GATEWAY__LLM_GATEWAY_BASE_URL=http://llm-gateway:8003
# 单实例可留空走进程内限流；多实例前接云 Redis
# API_GATEWAY__REDIS_URL=redis://...
API_GATEWAY__READY_PROBE_UPSTREAMS=false

# ── agent-orchestrator 下游 ─────────────────────────────────────────────────
AGENT_ORCHESTRATOR__ACCOUNT_SERVICE_URL=http://account-service:8001
AGENT_ORCHESTRATOR__LLM_GATEWAY_URL=http://llm-gateway:8003
AGENT_ORCHESTRATOR__LLM_ENABLED=true
AGENT_ORCHESTRATOR__TOOLS_ENABLED=true
AGENT_ORCHESTRATOR__TOOL_SERVICE_ENABLED=true
AGENT_ORCHESTRATOR__TOOL_SERVICE_URL=http://tool-service:8008
AGENT_ORCHESTRATOR__KNOWLEDGE_ENABLED=true
AGENT_ORCHESTRATOR__KNOWLEDGE_SERVICE_URL=http://knowledge-service:8006
AGENT_ORCHESTRATOR__WORKSPACE_ENABLED=true
AGENT_ORCHESTRATOR__WORKSPACE_SERVICE_URL=http://workspace-service:8005
AGENT_ORCHESTRATOR__OUTBOX_ENABLED=true
AGENT_ORCHESTRATOR__MCP_SECRET=CHANGE-ME
AGENT_ORCHESTRATOR__MCP_RESOURCE_URL=https://api-cvm.beautymoon.cn/mcp
AGENT_ORCHESTRATOR__MCP_OAUTH_REDIRECT_URI=https://api-cvm.beautymoon.cn/api/mcp/oauth/callback
AGENT_ORCHESTRATOR__CORS_ALLOW_ORIGINS=["https://app.beautymoon.cn"]
# 观测（可选）:只有 agent-orchestrator 与 llm-gateway 直连 Langfuse;
# 网关与其余服务只建 span、传播 traceparent（见 docs/design/langfuse-observability.md §5.1）
AGENT_ORCHESTRATOR__LANGFUSE_ENABLED=false

# ── 模型网关（唯一模型出口）─────────────────────────────────────────────────
LLM_GATEWAY__API_KEY=
LLM_GATEWAY__API_BASE=
LLM_GATEWAY__DEFAULT_MODEL=deepseek/deepseek-chat
LLM_GATEWAY__INTERNAL_SECRET=CHANGE-ME-hex32
LLM_GATEWAY__ACCOUNT_BASE_URL=http://account-service:8001

# ── workspace / 沙箱 ────────────────────────────────────────────────────────
WORKSPACE__ARTIFACT_ROOT=/data/artifacts
WORKSPACE__ARTIFACT_STORE=filesystem
# 轻量无 /dev/kvm：用外置 microVM 控制面 provider=e2b（E2B 官方云或阿里云
# Agent Sandbox 极速版，需注入 E2B_API_KEY），或在没有 Key 时用 unavailable
# （工具执行返回明确错误）；禁止在生产用 local（等价于在宿主机跑用户代码）。
# 见 README「沙箱」。
WORKSPACE__SANDBOX_PROVIDER=unavailable
# WORKSPACE__SANDBOX_PROVIDER=e2b
# E2B_API_KEY=CHANGE-ME-e2b-key
WORKSPACE__SANDBOX_REAPER_ENABLED=false

# ── tool-service ────────────────────────────────────────────────────────────
TOOL__INTERNAL_SECRET=CHANGE-ME-hex32
TOOL__WORKSPACE_SERVICE_URL=http://workspace-service:8005
TOOL__CONNECTOR_BASE_URL=http://connector-service:8004
TOOL__CONNECTOR_INTERNAL_SECRET=CHANGE-ME-connector-hex32

# ── connector-service ───────────────────────────────────────────────────────
CONNECTOR__CREDENTIAL_SECRET=CHANGE-ME-connector-hex32
CONNECTOR__INTERNAL_SECRET=CHANGE-ME-connector-hex32
CONNECTOR__OAUTH_REDIRECT_BASE=https://api-cvm.beautymoon.cn/api/connector
CONNECTOR__OAUTH_SUCCESS_REDIRECT=https://app.beautymoon.cn/connectors

# ── knowledge-service ───────────────────────────────────────────────────────
KNOWLEDGE__EMBEDDING_PROVIDER=local
KNOWLEDGE__LLM_GATEWAY_URL=http://llm-gateway:8003
KNOWLEDGE__INTERNAL_SECRET=CHANGE-ME-hex32
