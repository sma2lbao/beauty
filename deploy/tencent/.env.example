# 腾讯云生产环境变量样例（应用机：轻量首尔；基础设施机：同 VPC 的另一台服务器）。
# 复制为 deploy/tencent/.env 后逐项替换；.env 已被 git 忽略，禁止提交真实密钥。
# 应用机只跑 8 个无状态服务 + Caddy；Postgres / Redis / sandboxd 都在基础设施机上，
# 通过内网地址访问（安全组仅对应用机内网 IP 放行 5432 / 6379 / 8088）。
# 注意：文件名是 .env（不是 .env.production），compose 以 env_file: .env 注入全部服务。

# ── 镜像 ─────────────────────────────────────────────────────────────────────
# 由本地/CI 以 --platform linux/amd64 构建并推送 TCR 后填写：
#   docker build --platform linux/amd64 -f deploy/docker/python-service.Dockerfile \
#     --build-arg SERVICE=api-gateway -t $REGISTRY/beauty/python-service:$TAG .
REGISTRY=ccr.ccs.tencentyun.com/beauty
TAG=change-me

# ── 入口域名 ─────────────────────────────────────────────────────────────────
# DNS A 记录已指向本机公网 IP；Caddy 自动申请证书
API_HOST=api.beautymoon.cn

# ── 数据库（基础设施机自建 PostgreSQL 15，6 库，一服务一库）────────────────
# 与 compose 的 initdb 同构（deploy/postgres/initdb/01-create-databases.sql）：
# 6 条 alembic 链共用默认 alembic_version 表，所以必须一服务一库、
# 并在下面用 *__ALEMBIC_VERSION_TABLE 指定独立版本表（与本地库一致）。
# 同 VPC 内网访问无需 ssl；公网连接务必给 URL 加 ?ssl=require 并在基础设施机开启 TLS。
# 地址示例 10.8.0.14 是基础设施机的 VPC 内网 IP（当前生产暂用公网 IP 101.33.78.123）。
ACCOUNT__DATABASE_URL=postgresql+asyncpg://beauty_admin:CHANGE-ME-pg-password@10.8.0.14:5432/beauty_account
AGENT_ORCHESTRATOR__DATABASE_URL=postgresql+asyncpg://beauty_admin:CHANGE-ME-pg-password@10.8.0.14:5432/beauty_agent
CONNECTOR__DATABASE_URL=postgresql+asyncpg://beauty_admin:CHANGE-ME-pg-password@10.8.0.14:5432/beauty_connector
KNOWLEDGE__DATABASE_URL=postgresql+asyncpg://beauty_admin:CHANGE-ME-pg-password@10.8.0.14:5432/beauty_knowledge
WORKSPACE__DATABASE_URL=postgresql+asyncpg://beauty_admin:CHANGE-ME-pg-password@10.8.0.14:5432/beauty_workspace
TOOL__DATABASE_URL=postgresql+asyncpg://beauty_admin:CHANGE-ME-pg-password@10.8.0.14:5432/beauty_tool

# 迁移/建表一律关闭，生产由 alembic 负责
ACCOUNT__AUTO_CREATE_TABLES=false
AGENT_ORCHESTRATOR__AUTO_CREATE_TABLES=false
CONNECTOR__AUTO_CREATE_TABLES=false
KNOWLEDGE__AUTO_CREATE_TABLES=false
WORKSPACE__AUTO_CREATE_TABLES=false
TOOL__AUTO_CREATE_TABLES=false

# ── 鉴权（自建 IdP：account-service）────────────────────────────────────────
# 验签:token 的 iss 是公网 issuer,但边缘(Caddy→api-gateway)只路由 /api/*,
# `/.well-known/*` 与 `/jwks` 在公网不可达,故 JWKS 走集群内 account-service。
ACCOUNT__AUTH_ENABLED=true
ACCOUNT__AUTH_ISSUER=https://api.beautymoon.cn
ACCOUNT__AUTH_JWKS_URL=http://127.0.0.1:8001/jwks
ACCOUNT__SIGNING_KEY_PATH=/data/keys/account-signing-key.pem
# 与 gateway/orchestrator/llm-gateway/knowledge/tool 的 INTERNAL_SECRET 同值
ACCOUNT__INTERNAL_SECRET=CHANGE-ME-hex32
ACCOUNT__OAUTH_STATE_SECRET=CHANGE-ME-hex32
# GitHub OAuth App(回调 https://app.beautymoon.cn/api/auth/oauth/github/callback;
# 留空 = 关闭 GitHub 登录,见 services/account-service/README.md「社交 OAuth」)
ACCOUNT__GITHUB_CLIENT_ID=
ACCOUNT__GITHUB_CLIENT_SECRET=
ACCOUNT__OAUTH21_WEB_ORIGIN=https://app.beautymoon.cn
# 动态注册限流(OAuth 2.1):配 Redis 走固定窗口(多副本共享计数);留空回退进程内。
# Redis 在基础设施机(requirepass),内网访问。
ACCOUNT__REDIS_URL=redis://:CHANGE-ME-redis-password@10.8.0.14:6379

AGENT_ORCHESTRATOR__AUTH_ENABLED=true
AGENT_ORCHESTRATOR__AUTH_ISSUER=https://api.beautymoon.cn
AGENT_ORCHESTRATOR__AUTH_JWKS_URL=http://account-service:8001/jwks
AGENT_ORCHESTRATOR__INTERNAL_AUTH_SECRET=CHANGE-ME-hex32

CONNECTOR__AUTH_ENABLED=true
CONNECTOR__AUTH_ISSUER=https://api.beautymoon.cn
CONNECTOR__AUTH_JWKS_URL=http://account-service:8001/jwks
KNOWLEDGE__AUTH_ENABLED=true
KNOWLEDGE__AUTH_ISSUER=https://api.beautymoon.cn
KNOWLEDGE__AUTH_JWKS_URL=http://account-service:8001/jwks
TOOL__AUTH_ENABLED=true
TOOL__AUTH_ISSUER=https://api.beautymoon.cn
TOOL__AUTH_JWKS_URL=http://account-service:8001/jwks
WORKSPACE__AUTH_ENABLED=true
WORKSPACE__AUTH_ISSUER=https://api.beautymoon.cn
WORKSPACE__AUTH_JWKS_URL=http://account-service:8001/jwks

# ── API 网关 ────────────────────────────────────────────────────────────────
API_GATEWAY__APP_ORIGIN=https://app.beautymoon.cn
API_GATEWAY__RUNTIME_PUBLIC_URL=https://api.beautymoon.cn
API_GATEWAY__COOKIE_SECURE=true
API_GATEWAY__SESSION_SECRET=CHANGE-ME-hex32
API_GATEWAY__INTERNAL_SECRET=CHANGE-ME-hex32
API_GATEWAY__RUNTIME_BASE_URL=http://agent-orchestrator:8002
API_GATEWAY__ACCOUNT_BASE_URL=http://account-service:8001
API_GATEWAY__WORKSPACE_BASE_URL=http://workspace-service:8005
API_GATEWAY__KNOWLEDGE_BASE_URL=http://knowledge-service:8006
API_GATEWAY__CONNECTOR_BASE_URL=http://connector-service:8004
API_GATEWAY__LLM_GATEWAY_BASE_URL=http://llm-gateway:8003
# Redis 固定窗口限流(与 account-service 共用基础设施机的 Redis)
API_GATEWAY__REDIS_URL=redis://:CHANGE-ME-redis-password@10.8.0.14:6379
API_GATEWAY__READY_PROBE_UPSTREAMS=false
# 网关不直连 Langfuse,仅建 span/传播 traceparent(默认 false)
# API_GATEWAY__LANGFUSE_ENABLED=false

# ── agent-orchestrator 下游 ─────────────────────────────────────────────────
AGENT_ORCHESTRATOR__ACCOUNT_SERVICE_URL=http://account-service:8001
AGENT_ORCHESTRATOR__LLM_GATEWAY_URL=http://llm-gateway:8003
AGENT_ORCHESTRATOR__LLM_ENABLED=true
# AGENT_ORCHESTRATOR__LLM_MODEL=deepseek/deepseek-chat  # 不填走网关默认路由
AGENT_ORCHESTRATOR__TOOLS_ENABLED=true
AGENT_ORCHESTRATOR__TOOL_SERVICE_ENABLED=true
AGENT_ORCHESTRATOR__TOOL_SERVICE_URL=http://tool-service:8008
AGENT_ORCHESTRATOR__KNOWLEDGE_ENABLED=true
AGENT_ORCHESTRATOR__KNOWLEDGE_SERVICE_URL=http://knowledge-service:8006
AGENT_ORCHESTRATOR__WORKSPACE_ENABLED=true
AGENT_ORCHESTRATOR__WORKSPACE_SERVICE_URL=http://workspace-service:8005
AGENT_ORCHESTRATOR__OUTBOX_ENABLED=true
# 站内通知持久化（P1-J）：后台 sweeper 把最近变化的 run 幂等写进 notifications 表，
# 关掉页面也留未读；间隔 <=0 时只读表不再写入，保留期只清已读行。
# 见 docs/design/notifications.md
AGENT_ORCHESTRATOR__NOTIFICATIONS_ENABLED=true
AGENT_ORCHESTRATOR__NOTIFICATIONS_SWEEP_INTERVAL_SECONDS=30
AGENT_ORCHESTRATOR__NOTIFICATIONS_RETENTION_DAYS=30
AGENT_ORCHESTRATOR__MCP_SECRET=CHANGE-ME
AGENT_ORCHESTRATOR__MCP_RESOURCE_URL=https://api.beautymoon.cn/mcp
AGENT_ORCHESTRATOR__MCP_OAUTH_REDIRECT_URI=https://api.beautymoon.cn/api/mcp/oauth/callback
AGENT_ORCHESTRATOR__CORS_ALLOW_ORIGINS=["https://app.beautymoon.cn"]
# 观测（可选）:只有 agent-orchestrator 与 llm-gateway 直连 Langfuse;
# 网关与其余服务只建 span、传播 traceparent（见 docs/design/langfuse-observability.md §5.1）
AGENT_ORCHESTRATOR__LANGFUSE_ENABLED=false
# 启用后填项目密钥(与 llm-gateway 同项目,trace 跨服务串联成一条)
# AGENT_ORCHESTRATOR__LANGFUSE_HOST=https://cloud.langfuse.com
# AGENT_ORCHESTRATOR__LANGFUSE_PUBLIC_KEY=
# AGENT_ORCHESTRATOR__LANGFUSE_SECRET_KEY=

# ── 模型网关（唯一模型出口）─────────────────────────────────────────────────
LLM_GATEWAY__API_KEY=
LLM_GATEWAY__API_BASE=
LLM_GATEWAY__DEFAULT_MODEL=deepseek/deepseek-chat
# 模型列表(M0-11 静态配置):留空时只返回 default_model
# LLM_GATEWAY__AVAILABLE_MODELS=["deepseek/deepseek-chat","deepseek/deepseek-reasoner"]
LLM_GATEWAY__INTERNAL_SECRET=CHANGE-ME-hex32
LLM_GATEWAY__ACCOUNT_BASE_URL=http://account-service:8001
# Langfuse(可选):llm-gateway 直连上报;ENABLED=false 或密钥留空 = 不上报
LLM_GATEWAY__LANGFUSE_ENABLED=false
# LLM_GATEWAY__LANGFUSE_HOST=https://cloud.langfuse.com
# LLM_GATEWAY__LANGFUSE_PUBLIC_KEY=
# LLM_GATEWAY__LANGFUSE_SECRET_KEY=

# ── workspace / 沙箱 ────────────────────────────────────────────────────────
WORKSPACE__ARTIFACT_ROOT=/data/artifacts
WORKSPACE__ARTIFACT_STORE=filesystem
# 轻量机无 /dev/kvm：生产用外置隔离面。当前生产走 sandboxd
# （基础设施机上的 gVisor + Docker，内网访问，只填地址/token）；
# 托管 microVM（E2B 官方云 / 阿里云 Agent Sandbox 极速版）作为备选。
# 都没配时用 unavailable（工具执行返回明确错误）；禁止在生产用 local
# （等价于在宿主机跑用户代码）。见 README「沙箱」。
WORKSPACE__SANDBOX_PROVIDER=sandboxd
SANDBOXD_URL=http://10.8.0.14:8088
SANDBOXD_TOKEN=CHANGE-ME-sandboxd-token
WORKSPACE__SANDBOX_SANDBOXD_IMAGE=python:3.11-slim
WORKSPACE__SANDBOX_SANDBOXD_REQUEST_TIMEOUT_SECONDS=30
# 沙箱最大存活(默认 7200);sandboxd 由本服务透传 TTL,按机器容量调整
WORKSPACE__SANDBOX_MAX_TTL_SECONDS=7200
# 备选：托管 microVM
# WORKSPACE__SANDBOX_PROVIDER=e2b
# E2B_API_KEY=CHANGE-ME-e2b-key
WORKSPACE__SANDBOX_REAPER_ENABLED=false

# ── tool-service ────────────────────────────────────────────────────────────
TOOL__INTERNAL_SECRET=CHANGE-ME-hex32
TOOL__ACCOUNT_SERVICE_URL=http://account-service:8001
TOOL__WORKSPACE_SERVICE_URL=http://workspace-service:8005
TOOL__CONNECTOR_BASE_URL=http://connector-service:8004
TOOL__CONNECTOR_INTERNAL_SECRET=CHANGE-ME-connector-hex32

# ── connector-service ───────────────────────────────────────────────────────
CONNECTOR__CREDENTIAL_SECRET=CHANGE-ME-connector-hex32
CONNECTOR__INTERNAL_SECRET=CHANGE-ME-connector-hex32
CONNECTOR__OAUTH_REDIRECT_BASE=https://api.beautymoon.cn/api/connector
CONNECTOR__OAUTH_SUCCESS_REDIRECT=https://app.beautymoon.cn/connectors
# GitHub App:回调 URL 必须是
# https://api.beautymoon.cn/api/connector/v1/oauth/github/callback
CONNECTOR__PROVIDERS_ENABLED=github
CONNECTOR__GITHUB_CLIENT_ID=CHANGE-ME-github-app-client-id
CONNECTOR__GITHUB_CLIENT_SECRET=CHANGE-ME-github-app-client-secret

# ── knowledge-service ───────────────────────────────────────────────────────
KNOWLEDGE__EMBEDDING_PROVIDER=local
KNOWLEDGE__LLM_GATEWAY_URL=http://llm-gateway:8003
KNOWLEDGE__INTERNAL_SECRET=CHANGE-ME-hex32
